<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .gradient-bg { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        .card-hover { transition: all 0.3s ease; }
        .card-hover:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(0,0,0,0.1); }
    </style>
</head>
<body class="bg-gradient-to-br from-purple-50 to-indigo-50 min-h-screen">
    <div class="flex min-h-screen">
        <%- include('partials/sidebarMahasiswa', { currentPage: 'jadwal', praktikum: praktikum, user: user }) %>

        <main class="flex-1 p-6 lg:p-8 max-w-7xl mx-auto">
            <!-- Header Section -->
            <div class="mb-8 text-center lg:text-left">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-r from-purple-500 to-indigo-500 rounded-full mb-4 lg:mb-6">
                    <i class="fas fa-calendar-alt text-white text-2xl"></i>
                </div>
                <h1 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-3">Jadwal Praktikum</h1>
                <p class="text-xl text-gray-600 mb-2"><%= praktikum.nama_praktikum %></p>
                <div class="w-24 h-1 bg-gradient-to-r from-purple-500 to-indigo-500 mx-auto lg:mx-0 rounded-full"></div>
            </div>

            <!-- Stats Cards -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                <div class="bg-white rounded-2xl shadow-lg p-6 card-hover border-l-4 border-purple-500">
                    <div class="flex items-center">
                        <div class="p-3 bg-purple-100 rounded-full"><i class="fas fa-calendar-check text-purple-600 text-xl"></i></div>
                        <div class="ml-4">
                            <p class="text-sm font-medium text-gray-600">Total Pertemuan</p>
                            <p class="text-2xl font-bold text-gray-900"><%= daftarJadwal.length %></p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Jadwal Content -->
            <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
                <div class="gradient-bg px-8 py-6">
                    <h2 class="text-2xl font-bold text-white">📅 Daftar Pertemuan</h2>
                </div>
                <div class="p-8">
                    <% if (daftarJadwal.length > 0) { %>
                        <div class="space-y-6">
                            <% daftarJadwal.forEach((jadwal, index) => { %>
                                <div class="bg-gray-50 rounded-2xl shadow-lg overflow-hidden card-hover border border-gray-200">
                                    <div class="gradient-bg px-8 py-4">
                                        <div class="flex items-center space-x-4">
                                            <div class="w-12 h-12 bg-white bg-opacity-20 rounded-full flex items-center justify-center flex-shrink-0">
                                                <span class="text-white font-bold text-lg"><%= index + 1 %></span>
                                            </div>
                                            <div>
                                                <h3 class="text-xl font-bold text-white"><%= jadwal.materi %></h3>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- [FIX] Detail jadwal ditampilkan langsung di sini -->
                                    <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-6">
                                        <div class="flex items-center space-x-3">
                                            <i class="fas fa-calendar-day fa-lg text-purple-500"></i>
                                            <div>
                                                <p class="text-sm text-gray-500">Tanggal</p>
                                                <p class="font-semibold text-gray-800"><%= jadwal.tanggal_formatted %></p>
                                            </div>
                                        </div>
                                        <div class="flex items-center space-x-3">
                                            <i class="fas fa-clock fa-lg text-indigo-500"></i>
                                            <div>
                                                <p class="text-sm text-gray-500">Jam</p>
                                                <p class="font-semibold text-gray-800"><%= jadwal.jam_formatted %> WIB</p>
                                            </div>
                                        </div>
                                        <div class="flex items-center space-x-3">
                                            <i class="fas fa-map-marker-alt fa-lg text-violet-500"></i>
                                            <div>
                                                <p class="text-sm text-gray-500">Ruangan</p>
                                                <p class="font-semibold text-gray-800"><%= jadwal.ruangan || 'N/A' %></p>
                                            </div>
                                        </div>
                                        <div class="flex items-center space-x-3">
                                            <i class="fas fa-user-tie fa-lg text-fuchsia-500"></i>
                                            <div>
                                                <p class="text-sm text-gray-500">Nama Pengajar</p>
                                                <p class="font-semibold text-gray-800"><%= jadwal.nama_pengajar || 'N/A' %></p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-16">
                            <h3 class="text-2xl font-bold text-gray-900">Belum ada jadwal</h3>
                            <p class="text-gray-600 text-lg">Jadwal praktikum belum diatur oleh asisten.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
