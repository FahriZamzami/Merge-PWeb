<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Edit Kelas - <%= praktikum.nama_praktikum %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
    </style>
</head>
<body class="bg-[#A188E3]">
    <div class="flex h-screen">
        <aside class="w-72 bg-[#6D28D9] text-white flex flex-col p-4 flex-shrink-0">
            <div class="flex items-center justify-between p-4">
                <h1 class="text-2xl font-bold tracking-wider">LABCORNER</h1>
            </div>
            <nav class="flex-1 px-2 mt-8 space-y-3">
                <a href="/lab" class="flex items-center space-x-4 p-3 rounded-lg text-white/80 hover:bg-white/10">
                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 9.5L12 2L21 9.5V20C21 20.5304 20.7893 21.0391 20.4142 21.4142C20.0391 21.7893 19.5304 22 19 22H5C4.46957 22 3.96086 21.7893 3.58579 21.4142C3.21071 21.0391 3 20.5304 3 20V9.5Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 22V12H15V22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span class="font-semibold">Home Lab</span>
                </a>
                <a href="/lab/<%= praktikum.lab_id %>/jadwal" class="flex items-center space-x-4 p-3 rounded-lg text-white/80 hover:bg-white/10">
                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8 2V5M16 2V5M3 8H21M5 22H19C20.1046 22 21 21.1046 21 20V5C21 3.89543 20.1046 3 19 3H5C3.89543 3 3 3.89543 3 5V20C3 21.1046 3.89543 22 5 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span class="font-medium">Jadwal Lab</span>
                </a>
                <a href="/lab/<%= praktikum.lab_id %>/mahasiswa" class="flex items-center space-x-4 p-3 rounded-lg text-white/80 hover:bg-white/10">
                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M17 21V19C17 17.9391 16.5786 16.9217 15.8284 16.1716C15.0783 15.4214 14.0609 15 13 15H5C3.93913 15 2.92172 15.4214 2.17157 16.1716C1.42143 16.9217 1 17.9391 1 19V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 11C11.2091 11 13 9.20914 13 7C13 4.79086 11.2091 3 9 3C6.79086 3 5 4.79086 5 7C5 9.20914 6.79086 11 9 11Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M23 21V19C22.9992 17.9831 22.5932 17.0132 21.8727 16.2927C21.1522 15.5722 20.1824 15.1662 19.165 15.13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M17 11C18.8475 10.9992 20.4839 9.59382 20.8942 7.8249C21.3045 6.05598 20.4787 4.25338 18.9416 3.23863C17.4045 2.22388 15.4673 2.20339 13.9055 3.18516" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span class="font-medium">Semua Mahasiswa Lab</span>
                </a>
            </nav>
            <div class="mt-auto p-2">
                <a href="/logout" class="w-full flex items-center space-x-4 p-3 rounded-lg text-white/90 bg-red-500 hover:bg-red-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H3"></path></svg>
                    <span class="font-semibold">Logout</span>
                </a>
            </div>
        </aside>

        <div class="flex-1 flex flex-col overflow-y-auto">
            <main class="p-8">
                <h1 class="text-4xl font-bold text-white text-center mb-12">
                    Edit Kelas Praktikum
                </h1>

                <div class="max-w-3xl mx-auto">
                    <form action="/kelas/<%= praktikum.id %>/update" method="POST" class="bg-white p-10 rounded-2xl shadow-xl w-full">
                        <h2 class="text-2xl font-bold text-center mb-8 text-gray-800">Detail Kelas</h2>
    
                        <div class="space-y-5">
                            <div>
                                <label class="block text-purple-600 font-semibold mb-1">Nama Praktikum</label>
                                <input type="text" name="nama_praktikum" value="<%= praktikum.nama_praktikum %>"
                                    class="w-full border rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-400 transition" required />
                            </div>
    
                            <div>
                                <label class="block text-purple-600 font-semibold mb-1">Lab</label>
                                <select name="lab_id" class="w-full border rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-400 transition" required>
                                    <% labs.forEach(lab => { %>
                                        <option value="<%= lab.id %>" <%= praktikum.lab_id === lab.id ? 'selected' : '' %>>
                                            <%= lab.nama_lab %>
                                        </option>
                                    <% }) %>
                                </select>
                            </div>
    
                            <div>
                                <label class="block text-purple-600 font-semibold mb-1">Kode Masuk</label>
                                <input type="text" name="kode_masuk" value="<%= praktikum.kode_masuk %>"
                                    class="w-full border rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-400 transition" required />
                            </div>
                        </div>
    
                        <div class="flex justify-between mt-8">
                            <a href="/lab" class="bg-gray-300 text-gray-800 px-6 py-3 rounded-lg hover:bg-gray-400 font-semibold transition-colors">Batal</a>
                            <button type="submit" class="bg-indigo-600 text-white px-6 py-3 rounded-lg hover:bg-indigo-700 font-semibold transition-colors">Simpan Perubahan</button>
                        </div>
                    </form>
                </div>
            </main>
        </div>
    </div>
</body>
</html>