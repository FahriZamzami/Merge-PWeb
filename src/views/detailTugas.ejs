<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-gray-50 font-sans">
    <div class="flex min-h-screen">
        <%- include('partials/sidebarMahasiswa', { currentPage: 'assignments', praktikum: praktikum, user: user }) %>

        <main class="flex-1 p-6 lg:p-8">
            <div class="max-w-4xl mx-auto">
                <div class="flex items-center mb-8">
                    <a href="/tugas" class="text-gray-500 hover:text-gray-800 mr-4">
                        <i class="fas fa-arrow-left fa-lg"></i>
                    </a>
                    <h1 class="text-3xl font-bold text-gray-800"><%= tugas.judul %></h1>
                </div>

                <div class="bg-white p-8 rounded-2xl shadow-lg mb-8">
                    <div class="flex justify-between items-center mb-6 pb-4 border-b">
                        <div>
                            <p class="text-sm text-gray-500">Batas Waktu</p>
                            <p class="font-semibold text-gray-800"><%= tugas.batas_waktu_formatted %></p>
                        </div>
                        <div class="text-right">
                            <p class="text-sm text-gray-500">Status</p>
                            <% if (['open', 'aktif'].includes(tugas.status.toLowerCase())) { %>
                                <span class="px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full bg-green-100 text-green-800">Buka</span>
                            <% } else { %>
                                <span class="px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full bg-red-100 text-red-800">Tutup</span>
                            <% } %>
                        </div>
                    </div>
                    
                    <div class="mb-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-2">Deskripsi Tugas</h3>
                        <div class="prose max-w-none text-gray-600">
                            <%- tugas.deskripsi || 'Tidak ada deskripsi untuk tugas ini.' %>
                        </div>
                    </div>
                    
                    <div class="pt-6 border-t">
                        <h3 class="text-lg font-semibold text-gray-800 mb-2">File Lampiran</h3>
                        <% if (tugas.fileTugas && tugas.fileTugas.trim() !== '') { %>
                            <a href="/uploads/<%= tugas.fileTugas %>" target="_blank" class="inline-flex items-center bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium py-2 px-4 rounded-lg transition-colors">
                                <i class="fas fa-paperclip mr-2"></i>
                                <span><%= tugas.fileTugas.split('-').slice(1).join('-') || tugas.fileTugas %></span>
                            </a>
                        <% } else { %>
                            <p class="text-gray-500 italic">Tidak ada file lampiran untuk tugas ini.</p>
                        <% } %>
                    </div>
                </div>

                <div class="bg-white p-8 rounded-2xl shadow-lg">
                    <h3 class="text-2xl font-bold text-gray-800 mb-6">Pengumpulan Anda</h3>

                    <% if (submittedFile) { %>
                        <%
                           // ### FIX 2: Added a validity check for the date ###
                           const submissionDate = new Date(submittedFile.waktu_pengumpulan);
                           let formattedSubmissionDate = 'Waktu tidak valid'; // Fallback text

                           // Check if the date is valid before trying to format it
                           if (!isNaN(submissionDate.getTime())) {
                               const options = { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' };
                               formattedSubmissionDate = submissionDate.toLocaleString('id-ID', options);
                           }
                        %>
                        <div class="bg-green-50 border-l-4 border-green-400 text-green-800 p-6 rounded-lg">
                            <strong class="font-bold block mb-2">✅ Sudah Dikumpulkan</strong>
                            <div class="flex items-center space-x-3 mb-2">
                                <i class="fas fa-file-alt"></i>
                                <a href="/uploads/<%= submittedFile.file_path %>" target="_blank" class="underline hover:text-green-900 font-medium">
                                    <%= submittedFile.file_path.split('-').slice(1).join('-') || submittedFile.file_path %>
                                </a>
                            </div>
                            <p class="text-sm mb-4">Dikumpulkan pada: <%= formattedSubmissionDate %></p>
                            
                            <div class="border-t pt-4">
                                <% if (submittedFile.nilai !== null) { %>
                                    <p class="font-semibold">Nilai: <span class="text-2xl font-bold text-green-700"><%= submittedFile.nilai %></span></p>
                                <% } else { %>
                                    <p class="font-semibold text-yellow-700">Belum dinilai</p>
                                <% } %>
                                <% if (submittedFile.catatan_asisten) { %>
                                    <p class="text-sm italic mt-2">Catatan Asisten: <%= submittedFile.catatan_asisten %></p>
                                <% } %>
                            </div>
                            
                            <% if (['open', 'aktif'].includes(tugas.status.toLowerCase())) { %>
                                <div class="mt-6">
                                    <button onclick="deleteSubmission('<%= tugas.id %>')" class="bg-red-500 text-white font-bold py-2 px-4 rounded-lg hover:bg-red-600 transition-colors">
                                        <i class="fas fa-trash-alt mr-2"></i>Batalkan & Ganti File
                                    </button>
                                </div>
                            <% } %>
                        </div>
                    <% } else { %>
                        <% if (['open', 'aktif'].includes(tugas.status.toLowerCase())) { %>
                            <form id="uploadForm" class="space-y-4">
                                <div>
                                    <label for="file" class="block text-gray-700 text-sm font-bold mb-2">Pilih File untuk Diunggah:</label>
                                    <input type="file" id="file" name="fileTugas" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-purple-50 file:text-purple-700 hover:file:bg-purple-100" required />
                                </div>
                                <button type="submit" class="w-full bg-purple-600 text-white font-bold py-3 px-6 rounded-lg shadow-md hover:bg-purple-700 transition-colors">
                                    <i class="fas fa-upload mr-2"></i>Kumpulkan Tugas
                                </button>
                            </form>
                        <% } else { %>
                            <div class="bg-gray-100 text-center p-8 rounded-lg">
                                <i class="fas fa-lock fa-2x text-gray-400 mb-4"></i>
                                <p class="font-semibold text-gray-700">Tugas Telah Ditutup</p>
                                <p class="text-sm text-gray-500">Anda tidak dapat lagi mengumpulkan tugas ini.</p>
                            </div>
                        <% } %>
                    <% } %>
                </div>
            </div>
        </main>
    </div>

<script>
    // No changes needed for the script, it is correct.
    const uploadForm = document.getElementById('uploadForm');
    if (uploadForm) {
        uploadForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            const url = `/assignments/<%= tugas.id %>/submit`;

            try {
                const response = await fetch(url, { method: 'POST', body: formData });
                const data = await response.json();
                alert(data.message);
                if (response.ok) { window.location.reload(); }
            } catch (error) {
                console.error('Upload error:', error);
                alert('Terjadi kesalahan saat mengunggah.');
            }
        });
    }

    async function deleteSubmission(tugasId) {
        if (!confirm('Apakah Anda yakin ingin menghapus pengumpulan ini? File yang ada akan dihapus dan Anda bisa mengunggah file baru.')) { return; }
        try {
            const response = await fetch(`/assignments/${tugasId}/delete-submission`, { method: 'DELETE' });
            const data = await response.json();
            alert(data.message);
            if (response.ok) { window.location.reload(); }
        } catch (error) {
            console.error('Deletion error:', error);
            alert('Gagal menghapus pengumpulan.');
        }
    }
</script>
</body>
</html>
