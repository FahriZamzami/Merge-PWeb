<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .gradient-bg { background: linear-gradient(135deg, #2dd4bf 0%, #0d9488 100%); }
    </style>
</head>
<body class="bg-gray-50 font-sans">
    <div class="flex h-screen">
        <%- include('partials/sidebarMahasiswa', { currentPage: 'rekapAbsensi', praktikum: praktikum, user: user }) %>

        <div class="flex-1 flex flex-col overflow-hidden">
            <header class="gradient-bg text-white shadow-lg">
                <div class="px-8 py-6">
                    <h1 class="text-3xl font-bold">Rekap Absensi</h1>
                    <p class="text-lg opacity-90">Kehadiran Anda di kelas <%= praktikum.nama_praktikum %></p>
                </div>
            </header>

            <main class="flex-1 overflow-y-auto p-8">
                <div class="bg-white rounded-2xl shadow-xl p-8 mb-8 border-l-4 border-teal-500">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-lg font-medium text-gray-600">Persentase Kehadiran</p>
                            <p class="text-5xl font-bold text-teal-600"><%= persentaseKehadiran %>%</p>
                        </div>
                        <div class="text-right">
                             <p class="text-lg font-medium text-gray-600">Total Pertemuan</p>
                            <p class="text-5xl font-bold text-gray-800"><%= totalPertemuan %></p>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
                    <div class="p-6 border-b flex justify-between items-center">
                        <h2 class="text-2xl font-bold text-gray-800">Riwayat Kehadiran</h2>
                        <a href="/rekap-absensi-mahasiswa/pdf" class="bg-teal-500 hover:bg-teal-600 text-white font-bold py-2 px-4 rounded-lg transition-colors flex items-center">
                            <i class="fas fa-file-pdf mr-2"></i>
                            Ekstrak PDF
                        </a>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Pertemuan</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Materi</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tanggal</th>
                                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                <% rekapAbsensi.forEach(item => { %>
                                    <tr>
                                        <td class="px-6 py-4 whitespace-nowrap font-semibold text-gray-700"><%= item.pertemuan %></td>
                                        <td class="px-6 py-4 whitespace-nowrap text-gray-800"><%= item.materi %></td>
                                        <td class="px-6 py-4 whitespace-nowrap text-gray-500"><%= item.tanggal %></td>
                                        <td class="px-6 py-4 whitespace-nowrap text-center">
                                            <% if (item.status === 'Hadir') { %>
                                                <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                                                    <i class="fas fa-check-circle mr-2"></i>Hadir
                                                </span>
                                            <% } else if (item.status === 'Izin' || item.status === 'Sakit') { %>
                                                <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                                                    <i class="fas fa-info-circle mr-2"></i><%= item.status %>
                                                </span>
                                            <% } else { %>
                                                <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                                                    <i class="fas fa-times-circle mr-2"></i>Tidak Hadir
                                                </span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                                <% if (rekapAbsensi.length === 0) { %>
                                    <tr>
                                        <td colspan="4" class="text-center py-10 text-gray-500">Belum ada data absensi.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>
        </div>
    </div>
</body>
</html>
