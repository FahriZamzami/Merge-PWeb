<style>
    /* Menyembunyikan scrollbar secara default untuk Firefox */
    .sidebar-menu {
        scrollbar-width: thin;
        scrollbar-color: transparent transparent;
    }

    /* Menampilkan scrollbar di Firefox saat sidebar di-hover */
    .sidebar:hover .sidebar-menu {
        scrollbar-color: #7c3aed transparent; /* Warna thumb dan track */
    }

    /* Styling untuk browser basis Webkit (Chrome, Safari, Edge) */
    .sidebar-menu::-webkit-scrollbar {
        width: 8px; /* Lebar scrollbar */
    }

    .sidebar-menu::-webkit-scrollbar-track {
        background: transparent; /* Latar belakang track dibuat transparan */
    }

    .sidebar-menu::-webkit-scrollbar-thumb {
        background-color: transparent; /* Gagang scrollbar dibuat transparan */
        border-radius: 10px;
    }

    /* Menampilkan gagang scrollbar saat sidebar di-hover */
    .sidebar:hover .sidebar-menu::-webkit-scrollbar-thumb {
        background-color: #7c3aed; /* Ganti warna ini sesuai selera */
    }
</style>

<aside class="sidebar w-64 bg-purple-900 text-white p-6 flex flex-col h-screen sticky top-0">
    <div>
        <div class="flex justify-center mb-8">
            <a href="/home">
                <img src="/assets/image/LabCorner.png" alt="Labcorner Logo" class="h-16 w-auto object-contain">
            </a>
        </div>
        
        <% if (typeof praktikum !== 'undefined' && praktikum) { %>
            <div class="bg-purple-800 rounded-lg p-4 mb-6">
                <div class="flex items-center mb-2">
                    <i class="fas fa-graduation-cap text-purple-300 mr-2"></i>
                    <span class="text-sm font-semibold text-purple-300">Praktikum Aktif</span>
                </div>
                <h3 class="text-white font-bold text-lg leading-tight">
                    <%= praktikum.nama_praktikum %>
                </h3>
                <% if (praktikum.lab && praktikum.lab.nama_lab) { %>
                    <p class="text-purple-200 text-sm mt-1">
                        <i class="fas fa-flask mr-1"></i>
                        <%= praktikum.lab.nama_lab %>
                    </p>
                <% } %>
            </div>
        <% } %>
    </div>
    
    <div class="sidebar-menu flex-grow overflow-y-auto">
        <ul class="space-y-4">
            <li>
                <a href="/home" class="block py-3 text-lg hover:bg-purple-700 px-4 rounded-md transition-colors <% if (currentPage === 'home') { %> bg-purple-700 <% } %>">
                    <i class="fas fa-home mr-3"></i>Dashboard
                </a>
            </li>

            <li>
                <a href="/dashboard-kelas" class="block py-3 text-lg hover:bg-purple-700 px-4 rounded-md transition-colors <% if (currentPage === 'dashboardKelas') { %> bg-purple-700 <% } %>">
                    <i class="fas fa-th-large mr-3"></i>Pilih Kelas
                </a>
            </li>
            <li>
                <a href="/modul-materi" class="block py-3 text-lg hover:bg-purple-700 px-4 rounded-md transition-colors <% if (currentPage === 'modul') { %> bg-purple-700 <% } %>">
                    <i class="fas fa-book mr-3"></i>Modul Materi
                </a>
            </li>
            <li>
                <a href="/tugas" class="block py-3 text-lg hover:bg-purple-700 px-4 rounded-md transition-colors <% if (currentPage === 'tugas') { %> bg-purple-700 <% } %>">
                    <i class="fas fa-tasks mr-3"></i>Tugas
                </a>
            </li>
            <li>
                <a href="/jadwal-kelas" class="block py-3 text-lg hover:bg-purple-700 px-4 rounded-md transition-colors <% if (currentPage === 'jadwal') { %> bg-purple-700 <% } %>">
                    <i class="fas fa-calendar-alt mr-3"></i>Jadwal
                </a>
            </li>
            <li>
                <a href="/pengumuman-mahasiswa" class="block py-3 text-lg hover:bg-purple-700 px-4 rounded-md transition-colors <% if (currentPage === 'pengumuman') { %> bg-purple-700 <% } %>">
                    <i class="fas fa-bullhorn mr-3"></i>Pengumuman
                </a>
            </li>
            <li>
                <a href="/rekap-nilai-mahasiswa" class="block py-3 text-lg hover:bg-purple-700 px-4 rounded-md transition-colors <% if (currentPage === 'rekapNilai') { %> bg-purple-700 <% } %>">
                    <i class="fas fa-chart-line mr-3"></i>Rekap Nilai
                </a>
            </li>
            <li>
                <a href="/rekap-absensi-mahasiswa" class="block py-3 text-lg hover:bg-purple-700 px-4 rounded-md transition-colors <% if (currentPage === 'rekapAbsensi') { %> bg-purple-700 <% } %>">
                    <i class="fas fa-user-check mr-3"></i>Rekap Absensi
                </a>
            </li>
        </ul>
    </div>
    
    <div class="mt-auto">
        <ul>
            <li class="pt-4 border-t border-purple-700">
                <a href="/logout" class="block w-full text-left py-3 text-lg hover:bg-purple-700 px-4 rounded-md transition-colors">
                    <i class="fas fa-sign-out-alt mr-3"></i>Logout
                </a>
                </li>
        </ul>
    </div>
</aside>